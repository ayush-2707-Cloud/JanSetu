# ==============================================================================
# LegalPath Backend Configuration Template
# Copy this file to .env.local and fill in your credentials
# ==============================================================================

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/legalpath?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace-with-a-random-32-char-secret-key-for-jwt-signing
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend & Feature Flags
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_DOC_ANALYZER=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
